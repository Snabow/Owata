{
  "name": "owata",
  "version": "0.0.1-genesis",
  "description": "OWATA is an autonomous development platform that gets unfinished projects to done.",
  "type": "module",
  "bin": {
    "owata": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "canary": "npm run build && node dist/canary/b1-session-replacement-canary.js",
    "canary:b2-reviewer": "npm run build && node dist/canary/b2-reviewer-canary.js",
    "canary:b2-full": "npm run build && node dist/canary/b2-full-no-relay-canary.js",
    "owata": "node dist/cli.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
